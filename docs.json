{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Juno",
  "description": "Documentation for Juno.",
  "colors": {
    "primary": "#21201C",
    "light": "#FDFCFB",
    "dark": "#181713"
  },
  "favicon": {
    "light": "/favicon.png",
    "dark": "/favicon-dark.png"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Capabilities",
            "pages": [
              "capabilities/cloud-computer",
              "capabilities/connectors",
              "capabilities/browser",
              "capabilities/file-system",
              "capabilities/code",
              "capabilities/scheduling",
              "capabilities/memory",
              "capabilities/email"
            ]
          },
          {
            "group": "Workspaces & team",
            "pages": [
              "workspaces/using-workspaces",
              "workspaces/inviting-your-team"
            ]
          },
          {
            "group": "Credits & billing",
            "pages": [
              "billing/how-credits-work",
              "billing/managing-your-plan"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "href": "/changelog"
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://getjuno.com",
          "icon": "house"
        },
        {
          "anchor": "Connectors",
          "href": "https://getjuno.com/connectors",
          "icon": "plug"
        },
        {
          "anchor": "Playbooks",
          "href": "https://getjuno.com/playbooks",
          "icon": "book-open"
        },
        {
          "anchor": "App",
          "href": "https://app.getjuno.com",
          "icon": "right-to-bracket"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://getjuno.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hey@getjuno.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://app.getjuno.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "website": "https://getjuno.com"
    }
  }
}
